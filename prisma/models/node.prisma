enum NodeAccess {
    direct
    wireguard
}

enum NodeRole {
    discovery
    registry
}

model Node {
    id     String     @id @default(cuid())
    name   String
    host   String
    access NodeAccess @default(direct)
    csr    String?    @unique
    role   NodeRole[] @default([])
    version String?
    realm  Realm

    wireguard   NodeWireguard?
    wireguardId String?

    owner   Organisation   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([host, realm])
}

model NodeWireguard {
    id        String @id @default(cuid())
    pubkey    String @unique
    preshared String

    node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
    nodeId String @unique

    lighthouse   Lighthouse @relation(fields: [lighthouseId], references: [id], onDelete: Cascade)
    lighthouseId String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
