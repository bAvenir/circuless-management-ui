model Organisation {
    id    String @id @default(cuid())
    kcId  String @unique
    name  String
    alias String
    users User[]
    realm Realm

    ingressPartnerships Partnership[] @relation("IngressPartnership")
    egressPartnerships  Partnership[] @relation("EgressPartnership")

    nodes Node[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([name, realm])
}
